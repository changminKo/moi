{
  "name": "@moi/paper-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build && node --eval \"fs.rmSync('dist/db/migrations', { recursive: true, force: true }); fs.cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "test": "vitest run --passWithNoTests --dir src",
    "typecheck": "tsc --build --pretty false",
    "test:drill": "vitest run --config vitest.drill.config.ts",
    "test:schema-compat": "vitest run --config vitest.schema-compat.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@moi/market-data": "workspace:*",
    "@moi/trading-core": "workspace:*",
    "es-hangul": "2.4.0",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@moi/strategy-runner": "workspace:*",
    "@moi/strategy-sdk": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "testcontainers": "12.1.0",
    "vitest": "4.1.11"
  }
}
