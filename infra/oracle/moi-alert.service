# OnFailure= target of moi.service: announces a failed stack start/stop with the
# tail of the unit's journal. Installed by bootstrap.sh / deploy.sh.
[Unit]
Description=Moi stack failure alert (Discord)

[Service]
Type=oneshot
WorkingDirectory=/opt/moi
EnvironmentFile=/etc/moi/moi.env
Environment=SOPS_AGE_KEY_FILE=/etc/moi/age.key
ExecStart=/usr/bin/sops exec-env /etc/moi/secrets.enc.env "/opt/moi/infra/oracle/alert-unit-failed.sh moi"
