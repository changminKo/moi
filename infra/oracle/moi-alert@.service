# OnFailure= handler template: `OnFailure=moi-alert@%n.service` in a unit makes
# systemd start `moi-alert@<that unit>.service`, and %i below is that unit's
# name. Posts the unit's journal tail (masked by notify.sh) to Discord.
# Installed by bootstrap.sh / deploy.sh. Only a failed *start or stop* of a
# oneshot unit fires this — a container dying later is caught by the 5-minute
# status check, not by systemd.
[Unit]
Description=Moi failure alert for %i (Discord)

[Service]
Type=oneshot
WorkingDirectory=/opt/moi
EnvironmentFile=/etc/moi/moi.env
Environment=SOPS_AGE_KEY_FILE=/etc/moi/age.key
ExecStart=/usr/bin/sops exec-env /etc/moi/secrets.enc.env "/opt/moi/infra/oracle/alert-unit-failed.sh %i"
