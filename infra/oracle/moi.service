# systemd unit for the Moi compose stack on the Oracle reference host.
# Installed by infra/oracle/bootstrap.sh to /etc/systemd/system/moi.service.
[Unit]
Description=Moi paper-trading stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# A failed start/stop is announced on Discord (infra/oracle/moi-alert.service).
OnFailure=moi-alert.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/moi
EnvironmentFile=/etc/moi/moi.env
# MOI_IMAGE_TAG may be set in moi.env to pin a published image; default main.
Environment=SOPS_AGE_KEY_FILE=/etc/moi/age.key
# Secrets are decrypted into the environment of docker compose only; this
# unit never writes them to a file. Docker itself records container
# environment in its metadata (/var/lib/docker, `docker inspect`), readable by
# root only — an accepted exposure, documented in the deployment guide.
# `stop` respects the 45 s stop_grace_period so the leader drains
# (CANCEL_ONLY -> outbox drain -> lease release) before exit.
ExecStart=/usr/bin/sops exec-env /etc/moi/secrets.enc.env '/usr/bin/docker compose -f infra/compose.yaml -f infra/oracle/compose.override.yaml up -d'
ExecStop=/usr/bin/sops exec-env /etc/moi/secrets.enc.env '/usr/bin/docker compose -f infra/compose.yaml -f infra/oracle/compose.override.yaml stop'
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
