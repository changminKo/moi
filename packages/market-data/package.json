{
  "name": "@skipjack/market-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/adapter-conformance.d.ts",
      "default": "./dist/adapter-conformance.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run --passWithNoTests --dir src",
    "typecheck": "tsc --build --pretty false && tsc --noEmit --pretty false -p tsconfig.test.json"
  },
  "dependencies": {
    "@skipjack/trading-core": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.11"
  }
}
